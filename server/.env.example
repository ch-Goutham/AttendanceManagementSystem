PORT=5000
MONGO_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Google Identity Services client ID (Web application). Must match
# VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=

# Transactional email.
# Resend is recommended, especially on Render free instances, which block
# outbound SMTP ports 25, 465 and 587.
RESEND_API_KEY=
MAIL_FROM=Attendwise <no-reply@yourdomain.com>

# Optional SMTP fallback (paid Render instances or other hosts).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL used to build password-reset links. Falls back to CLIENT_URL.
APP_URL=

# Attendance rules (wall-clock company time).
# Late = check-in after SHIFT_START + GRACE_MINUTES.
# Early checkout = check-out before SHIFT_END.
# A day becomes Half day when worked minutes are below HALF_DAY_MINUTES.
# WORKING_DAYS uses 0=Sunday .. 6=Saturday. 1,2,3,4,5,6 = Monday to Saturday.
SHIFT_START=09:30
SHIFT_END=18:00
GRACE_MINUTES=10
HALF_DAY_MINUTES=240
WORKING_DAYS=1,2,3,4,5,6
