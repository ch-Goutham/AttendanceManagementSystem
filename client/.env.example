# Development uses the Vite proxy: /api -> http://localhost:5000.
# Point the proxy at a different backend if needed:
# VITE_PROXY_TARGET=http://localhost:5000

# For a production build hosted separately from the API, set the full URL:
# VITE_API_URL=http://localhost:5000/api

# Google Identity Services client ID. Use the same value as GOOGLE_CLIENT_ID
# in server/.env. Leave blank to show a "not configured" message on the
# Continue with Google button.
# VITE_GOOGLE_CLIENT_ID=
